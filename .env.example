# Variables d'environnement Hospicloud (exemple)
# Copier vers .env sur le VPS (dossier gestion-hopital) — ne jamais committer .env.

OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
AI_ENABLED=true

# LiveKit Cloud — https://cloud.livekit.io → projet → Settings → Keys
# Sans ces clés, la téléconsultation affiche « LiveKit non configuré »
LIVEKIT_URL=wss://votre-projet.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxx
LIVEKIT_API_SECRET=votre_secret_livekit
