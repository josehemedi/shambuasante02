# Copier vers .env avant `docker compose up`
APP_VERSION=1.0.0
APP_PORT=8082
JAVA_OPTS=-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0

MYSQL_ROOT_PASSWORD=changeme_root
MYSQL_DATABASE=hospicloud
MYSQL_USER=hospicloud
MYSQL_PASSWORD=changeme_app
MYSQL_PORT=3310

RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PORT=5673
RABBITMQ_MGMT_PORT=15673

REDIS_PORT=6380
APP_REDIS_ENABLED=false

# Obligatoire en production — min. 32 caractères
APP_JWT_SECRET=shambua-change-me-in-production-use-long-secret-key-256bits
