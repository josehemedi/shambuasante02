# Variables d'environnement Hospicloud (exemple VPS)
# Copier vers .env dans /home/github-deployer/apps/gestion-hopital/
# Ne jamais committer de vrai .env.

APP_VERSION=1.0.0
APP_PORT=127.0.0.1:8083

JAVA_OPTS=-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0 -Dmanagement.health.mail.enabled=false -Dapp.cors.allowed-origins=https://gestionhopital.softyik.com,http://gestionhopital.softyik.com -Dapp.cors.allowed-origin-patterns=* -Dapp.frontend.base-url=https://gestionhopital.softyik.com

MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=hospicloud
MYSQL_USER=hospicloud
MYSQL_PASSWORD=change_me_app
MYSQL_PORT=127.0.0.1:3310

SPRING_DATASOURCE_URL=jdbc:mysql://shambua-mysql:3306/hospicloud?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=hospicloud
SPRING_DATASOURCE_PASSWORD=change_me_app

SPRING_RABBITMQ_HOST=shambua-rabbitmq
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=guest
SPRING_RABBITMQ_PASSWORD=guest
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PORT=127.0.0.1:5673
RABBITMQ_MGMT_PORT=127.0.0.1:15673

SPRING_DATA_REDIS_HOST=shambua-redis
SPRING_DATA_REDIS_PORT=6379
REDIS_PORT=127.0.0.1:6380
APP_REDIS_ENABLED=false

APP_JWT_SECRET=change_me_jwt_secret_min_32_chars_xxxxxxxxxxxx
APP_CORS_ALLOWED_ORIGINS=https://gestionhopital.softyik.com,http://gestionhopital.softyik.com

# URL du frontend (liens email activation / reset password)
# En prod : https://gestionhopital.softyik.com
APP_FRONTEND_BASE_URL=https://gestionhopital.softyik.com

OPENAI_API_KEY=sk-dummy-key-for-now-which-is-long-enough-to-pass-validation-checks
OPENAI_MODEL=gpt-4o-mini
AI_ENABLED=false

# LiveKit Cloud — https://cloud.livekit.io → Settings → Keys
LIVEKIT_URL=wss://votre-projet.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxx
LIVEKIT_API_SECRET=votre_secret_livekit
