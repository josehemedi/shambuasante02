# ===================================================================
# Configuration Hospicloud — exemple (versionné, sans secrets)
# Copier vers application-local.properties et renseigner vos valeurs :
#   copy application-local.properties.example application-local.properties
# ===================================================================

# JWT
app.jwt.secret=change-this-secret-in-production-min-256-bits
app.jwt.expiration-ms=86400000

# CORS (origines frontend autorisées, séparées par virgule)
app.cors.allowed-origins=http://localhost:5173,http://127.0.0.1:5173

# Base de données
spring.datasource.url=jdbc:mysql://localhost:3308/hospicloud?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
spring.datasource.username=root
spring.datasource.password=your_password

# ---------------------------------------------------------------------------
# OpenAI (assistant IA clinique)
# 1) Créer une clé : https://platform.openai.com/api-keys
# 2) Coller la clé ici OU exporter la variable d'environnement OPENAI_API_KEY
# 3) Ne jamais committer application-local.properties ni la clé dans GitHub
# Production : définir OPENAI_API_KEY dans les secrets du serveur / hébergeur
# ---------------------------------------------------------------------------
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
AI_ENABLED=true
